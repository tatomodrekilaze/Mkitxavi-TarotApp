# Copy to .env. VITE_ values are public browser configuration.
# Keep service credentials server-side.
VITE_SITE_URL=http://localhost:8080
VITE_SUPPORT_EMAIL=support@example.com
VITE_BUSINESS_EMAIL=business@example.com

# Your own Supabase project. Allow your site's /auth/callback URL in Auth settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Maria's responses
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Contact alerts use Resend, or FormSubmit when only an inbox is configured.
# Supabase Auth mail is configured separately in its dashboard.
CONTACT_NOTIFY_TO=
CONTACT_FROM=Mkitxavi <onboarding@resend.dev>
RESEND_API_KEY=
OPS_CONSOLE_GATE=
DISCORD_ADMIN_WEBHOOK=

# Choose whop, flitt, creem, or stripe; configure credentials before accepting payments.
VITE_BILLING_PROVIDER=whop
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_TOPUP=
WHOP_PRODUCT_MYSTIC=
WHOP_PRODUCT_ASCENDED=
WHOP_PLAN_TOPUP=
WHOP_PLAN_MYSTIC=
WHOP_PLAN_ASCENDED=
WHOP_COMPANY_ID=

# Flitt sandbox defaults
FLITT_MERCHANT_ID=1549901
FLITT_SECRET_KEY=test
FLITT_CALLBACK_BASE_URL=http://localhost:8080
CREEM_API_KEY=
CREEM_MODE=test
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_TOPUP=
CREEM_PRODUCT_MYSTIC=
CREEM_PRODUCT_ASCENDED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TOPUP=
STRIPE_PRICE_MYSTIC=
STRIPE_PRICE_ASCENDED=

# Optional ads: use your own advertising account.
VITE_GAM_REWARDED_AD_UNIT=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
VITE_ADS_SIMULATE=false
